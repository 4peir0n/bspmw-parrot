#! /bin/sh
pgrep -x sxhkd > /dev/null || sxhkd &

bspc monitor -d I II III IV V VI VII VIII IX X

bspc config border_width         2
bspc config window_gap           8
[ -f "$HOME/.config/polybar/palette.env" ] && . "$HOME/.config/polybar/palette.env"
bspc config focused_border_color  "${ACCENT:-#C084FC}"
bspc config active_border_color   "${DIM:-#7A7A7A}"
bspc config normal_border_color   "${DIM:-#7A7A7A}"
# Reserve room for the top polybar row (offset-y 15 + height 35 + borders).
bspc config top_padding          50
bspc config remove_disabled_monitors  true
bspc config remove_unplugged_monitors true

bspc config split_ratio          0.52
bspc config borderless_monocle   false
bspc config gapless_monocle      true

bspc rule -a Gimp desktop='^8' state=floating follow=on
bspc rule -a Chromium desktop='^2'
bspc rule -a mplayer2 state=floating
bspc rule -a Kupfer.py focus=on
bspc rule -a Screenkey manage=off
bspc rule -a firefox desktop='^3'

# Restore the last chosen wallpaper, then color the bars from its palette.
if [ -x "$HOME/.fehbg" ]; then
    "$HOME/.fehbg" &
else
    /usr/bin/feh --bg-fill "$HOME/Desktop/Wallpapers/Devil-girl.jpg" &
fi
"$HOME/.config/polybar/wallpaper-theme.sh" --apply-only >/dev/null 2>&1
pgrep -f 'wallpaper-watch.sh' >/dev/null || "$HOME/.config/polybar/wallpaper-watch.sh" >/dev/null 2>&1 &
~/.config/polybar/launch.sh &
pgrep -x picom >/dev/null || picom --config ~/.config/picom/picom.conf &
# Only force a fixed mode on the VirtualBox virtual output; real panels use SDDM's mode.
if xrandr --query 2>/dev/null | grep -q '^Virtual-1 '; then
    xrandr --output Virtual-1 --mode 1920x1080 &
fi
flameshot &
